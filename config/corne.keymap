#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        DEF {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp DOUBLE_QUOTES
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LGUI  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp RALT
            >;
        };

        NUM {
            bindings = <
&none  &none  &kp N1  &kp N2  &kp N3  &kp LBKT                &kp RBKT               &none      &none      &none  &none  &none
&none  &none  &kp N4  &kp N5  &kp N6  &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp MINUS  &kp EQUAL  &none  &none  &none
&none  &none  &kp N7  &kp N8  &kp N9  &kp LESS_THAN           &kp GREATER_THAN       &kp UNDER  &kp PLUS   &none  &none  &none
                      &kp N0  &none   &none                   &none                  &mo 3      &none
            >;
        };

        NAV {
            bindings = <
&none  &none  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &msc SCRL_UP       &none     &none     &none   &none      &none  &none
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN     &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &none
&none  &none  &none           &none           &msc SCRL_LEFT   &msc SCRL_RIGHT    &none     &none     &none   &none      &none  &none
                              &none           &mo 3            &none              &none     &none     &none
            >;
        };

        FUN {
            bindings = <
&none  &kp F1  &kp F2   &kp F3   &kp F4   &none             &bt BT_CLR  &none  &bl BL_TOG    &none  &none  &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &none             &bt BT_NXT  &none  &bl BL_CYCLE  &none  &none  &none
&none  &kp F9  &kp F10  &kp F11  &kp F12  &studio_unlock    &none       &none  &none         &none  &none  &none
                        &none    &none    &none             &none       &none  &none
            >;
        };
    };
};

&led_strip { chain-length = <27>; };
